{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gateway-production-b967efda.up.railway.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://gateway-production-b967efda.up.railway.app/health"
    },
    {
      "source": "/metrics",
      "destination": "https://gateway-production-b967efda.up.railway.app/metrics"
    },
    {
      "source": "/((?!api/|health|metrics|prometheus/).*)",
      "destination": "/index.html"
    }
  ]
}
