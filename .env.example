# GateKeeper Production Environment Configuration Template
# Copy this file to .env and configure values before starting Docker Compose.
# Never commit .env with actual secrets to version control.

# ==============================================================================
# Security & Authentication (Required)
# ==============================================================================
# Secret API key required by incoming client requests in the X-API-Key header.
GATEKEEPER_API_KEY=your-secure-gateway-api-key-here

# Authentication password for internal Redis rate limiter.
REDIS_PASSWORD=your-secure-redis-password-here

# PostgreSQL password (generate a URL-safe hex secret, e.g. openssl rand -hex 24).
POSTGRES_PASSWORD=your-secure-postgres-password-here

# Optional dashboard bootstrap. If omitted, use the first-run setup screen with GATEKEEPER_API_KEY.
# The password must be 12–72 bytes. Set both values or leave both blank.
DASHBOARD_ADMIN_EMAIL=
DASHBOARD_ADMIN_PASSWORD=
# Keep true behind HTTPS; set false only for local HTTP development.
DASHBOARD_SESSION_COOKIE_SECURE=true

# Optional OTLP HTTP collector base URL, for example http://collector:4318.
# Leave empty to disable trace export. No request bodies or credentials are exported.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Stable, unique identifier for each gateway replica's bounded Inspector history.
GATEWAY_INSTANCE_ID=default

# ==============================================================================
# Domain & Automated HTTPS (Caddy)
# ==============================================================================
# Primary domain pointing to your VPS IP (e.g., gatekeeper.yourdomain.com).
# Defaults to localhost for local testing.
DOMAIN_NAME=localhost
GATEKEEPER_HTTP_PORT=80
GATEKEEPER_HTTPS_PORT=443

# Email address for Let's Encrypt / ZeroSSL certificate expiry notifications.
ACME_EMAIL=admin@example.com

# Dedicated subdomain for Grafana monitoring (e.g., grafana.yourdomain.com).
# Defaults to grafana.localhost.
GRAFANA_DOMAIN=grafana.localhost

# ==============================================================================
# Grafana Administration
# ==============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-secure-grafana-password-here

# ==============================================================================
# GateKeeper Tuning & Policies (Optional Defaults)
# ==============================================================================
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN=10s
BACKEND_TIMEOUT=10s
UPSTREAM_MAX_RETRIES=0
UPSTREAM_RETRY_BACKOFF=100ms
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW=60s
# Options: round_robin, weighted_round_robin, least_connections, random.
LOAD_BALANCE_STRATEGY=round_robin
# One positive weight per URL in BACKEND_URLS; used by weighted_round_robin.
BACKEND_WEIGHTS=1,1
