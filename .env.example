# GateKeeper Production Environment Configuration Template
# Copy this file to .env and configure values before starting Docker Compose.
# Never commit .env with actual secrets to version control.

# ==============================================================================
# Security & Authentication (Required)
# ==============================================================================
# Secret API key required by incoming client requests in the X-API-Key header.
GATEKEEPER_API_KEY=your-secure-gateway-api-key-here

# Authentication password for internal Redis rate limiter.
REDIS_PASSWORD=your-secure-redis-password-here

# ==============================================================================
# Domain & Automated HTTPS (Caddy)
# ==============================================================================
# Primary domain pointing to your VPS IP (e.g., gatekeeper.yourdomain.com).
# Defaults to localhost for local testing.
DOMAIN_NAME=localhost

# Email address for Let's Encrypt / ZeroSSL certificate expiry notifications.
ACME_EMAIL=admin@example.com

# Dedicated subdomain for Grafana monitoring (e.g., grafana.yourdomain.com).
# Defaults to grafana.localhost.
GRAFANA_DOMAIN=grafana.localhost

# ==============================================================================
# Grafana Administration
# ==============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-secure-grafana-password-here

# ==============================================================================
# GateKeeper Tuning & Policies (Optional Defaults)
# ==============================================================================
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN=10s
BACKEND_TIMEOUT=10s
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW=60s
